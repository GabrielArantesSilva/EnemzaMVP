# Copie para .env e preencha com a connection string real do projeto Neon
# (dashboard do Neon → Connection Details).
#
# DATABASE_URL: endpoint POOLED (host com "-pooler") — usado em runtime.
# DIRECT_URL: endpoint DIRETO (sem "-pooler") — usado só por `prisma migrate`.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/enemza?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/enemza?sslmode=require"

# SESSION_SECRET: segredo usado para assinar o cookie de sessão (HMAC-SHA256).
# Gerar um valor aleatório forte, ex: `openssl rand -hex 32`. Nunca reaproveitar
# entre ambientes (dev/prod) nem commitar o valor real. Ver ADR-001.
SESSION_SECRET="troque-por-um-valor-aleatorio-forte"

# KIWIFY_CHECKOUT_URL: link do checkout na Kiwify. Usado pelo botão de venda em
# /cadastro (não há cadastro aberto — ver TD-0007). Sem essa var, a página
# mostra um aviso em vez de link quebrado.
KIWIFY_CHECKOUT_URL="https://pay.kiwify.com.br/xxxxxxx"

# KIWIFY_WEBHOOK_TOKEN: segredo escolhido por você, colocado como ?token=...
# na URL do webhook configurado no painel da Kiwify (Apps → Webhooks). Ver
# ADR-002 — a Kiwify não documenta assinatura criptográfica pro webhook
# clássico, então este token na própria URL é a validação de autenticidade.
KIWIFY_WEBHOOK_TOKEN="troque-por-um-valor-aleatorio-forte"

# CRON_SECRET: protege a rota /api/cron/reenviar-emails (dreno de e-mails de
# primeiro acesso pendentes, ver ADR-002 amendment 2026-08-05). A Vercel
# envia esse valor no header Authorization do cron automaticamente quando a
# var existe. O cron só executa no plano Pro — no Hobby, o self-healing é a
# chamada ao dreno dentro do próprio webhook. Sem essa var, a rota de cron
# responde 401 (inofensivo, rota não pública).
CRON_SECRET="troque-por-um-valor-aleatorio-forte"

# GMAIL_USUARIO / GMAIL_SENHA_APP / EMAIL_REMETENTE: envio do e-mail de
# "defina sua senha" após compra aprovada (ver ADR-002, amendment 2026-07-21
# — Gmail SMTP em vez de Resend, pra não depender de domínio próprio
# verificado). GMAIL_USUARIO é a caixa Gmail (ex: enemzasuporte@gmail.com);
# GMAIL_SENHA_APP é uma "Senha de app" gerada em myaccount.google.com/apppasswords
# (exige verificação em duas etapas ativada na conta) — nunca a senha normal
# da conta. EMAIL_REMETENTE precisa ter o MESMO endereço de GMAIL_USUARIO
# (Gmail rejeita From divergente do autenticado), ex:
# "Enemza <enemzasuporte@gmail.com>".
GMAIL_USUARIO="enemzasuporte@gmail.com"
GMAIL_SENHA_APP="xxxx xxxx xxxx xxxx"
EMAIL_REMETENTE="Enemza <enemzasuporte@gmail.com>"

# APP_URL: origem pública do app, usada para montar o link de primeiro
# acesso enviado por e-mail (ex: "https://enemza.vercel.app").
APP_URL="http://localhost:3000"

# NEXT_PUBLIC_POSTHOG_KEY / NEXT_PUBLIC_POSTHOG_HOST: analytics de produto
# (funil de uso — pageview, conclusão de aula). Precisam do prefixo
# NEXT_PUBLIC_ porque rodam no navegador. Projeto PostHog Cloud, região EU
# (não US, por minimização de dado — ver boundaries.md). Sem essas vars, o
# app roda normal, só sem tracking. Identificação usa Usuario.id (UUID),
# nunca e-mail. Autocapture e session recording ficam desligados por padrão.
NEXT_PUBLIC_POSTHOG_KEY="phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
